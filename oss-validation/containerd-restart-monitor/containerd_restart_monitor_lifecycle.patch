+func newMonitor(client *containerd.Client, interval time.Duration) *monitor {
+	ctx, cancel := context.WithCancel(context.Background())
+	m := &monitor{
+		client: client,
+		cancel: cancel,
+		done:   make(chan struct{}),
+	}
+	go func() {
+		defer close(m.done)
+		runMonitor(ctx, interval, m.reconcile)
+	}()
+	return m
+}
+
+// Close stops the monitor loop and waits for an in-flight reconciliation to
+// observe cancellation before the plugin is released.
+func (m *monitor) Close() error {
+	m.cancel()
+	<-m.done
+	return nil
+}
