+package monitor
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRunMonitorReconcilesImmediately(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := make(chan struct{}, 1)
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+		runMonitor(ctx, time.Hour, func(context.Context) error {
+			calls <- struct{}{}
+			return nil
+		})
+	}()
+
+	select {
+	case <-calls:
+	case <-time.After(time.Second):
+		t.Fatal("initial reconciliation did not run")
+	}
+
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("monitor did not stop after cancellation")
+	}
+}
+
+func TestRunMonitorRepeatsOnInterval(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := make(chan struct{}, 4)
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+		runMonitor(ctx, time.Millisecond, func(context.Context) error {
+			select {
+			case calls <- struct{}{}:
+			default:
+			}
+			return nil
+		})
+	}()
+
+	for range 2 {
+		select {
+		case <-calls:
+		case <-time.After(time.Second):
+			t.Fatal("periodic reconciliation did not run")
+		}
+	}
+
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("monitor did not stop after cancellation")
+	}
+}
+
+func TestRunMonitorPassesCancellationToReconcile(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	entered := make(chan struct{})
+	done := make(chan struct{})
+
+	go func() {
+		defer close(done)
+		runMonitor(ctx, time.Hour, func(ctx context.Context) error {
+			close(entered)
+			<-ctx.Done()
+			return ctx.Err()
+		})
+	}()
+
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("reconciliation did not start")
+	}
+	cancel()
+
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("in-flight reconciliation did not observe cancellation")
+	}
+}
+
+func TestMonitorCloseIsIdempotent(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	m := &monitor{cancel: cancel, done: done}
+	go func() {
+		<-ctx.Done()
+		close(done)
+	}()
+
+	if err := m.Close(); err != nil {
+		t.Fatalf("first Close() failed: %v", err)
+	}
+	if err := m.Close(); err != nil {
+		t.Fatalf("second Close() failed: %v", err)
+	}
+}
